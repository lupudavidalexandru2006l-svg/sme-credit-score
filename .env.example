# Copy to .env.local. Everything is optional: without Supabase the app runs in guest mode with data saved in the browser.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key: enables accounts (Supabase Auth, email + password) in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by the API routes. Never expose it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (/admin)
# Comma-separated emails that are always admins (in addition to profiles.role = 'admin').
ADMIN_EMAILS=
# Hackathon demo admin: the code typed on /login ("Acces demo admin") opens /admin for 8 hours. Empty = disabled.
ADMIN_DEMO_CODE=

# RO e-Factura (SPV) automatic import — app registered in the ANAF developer portal (OAuth 2.0, digital certificate)
ANAF_OAUTH_CLIENT_ID=
ANAF_OAUTH_CLIENT_SECRET=
# e.g. http://localhost:3000/api/spv/callback (must match the URL registered at ANAF)
ANAF_OAUTH_REDIRECT_URI=

# External quiz website (optional)
NEXT_PUBLIC_EXTERNAL_QUIZ_URL=
# Shared secret the quiz site sends in the x-quiz-secret header of POST /api/quiz
QUIZ_WEBHOOK_SECRET=
