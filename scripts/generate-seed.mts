/**
 * Generates supabase/seed.sql from the same deterministic generator the app uses.
 * Run: npm run seed:sql
 */
import { writeFileSync } from "node:fs";
import { SECTOR_BENCHMARKS } from "../src/lib/data/benchmarks.ts";
import { DEMO_COMPANY, generateSyntheticInvoices } from "../src/lib/data/synthetic.ts";

const q = (v: string | number | null) => (v === null ? "null" : typeof v === "number" ? String(v) : `'${v.replace(/'/g, "''")}'`);

const c = DEMO_COMPANY;
const lines: string[] = [
  "-- Generated by scripts/generate-seed.mts — synthetic data for a FICTIONAL company. Do not edit by hand.",
  "begin;",
  "",
  `delete from public.companies where cui = ${q(c.cui)};`,
  `insert into public.companies (id, name, cui, caen_code, ceo_name, city, monthly_fixed_costs, existing_monthly_debt_service) values (${[c.id, c.name, c.cui, c.caenCode, c.ceoName, c.city].map(q).join(", ")}, ${c.monthlyFixedCosts}, ${c.existingMonthlyDebtService});`,
  "",
  "insert into public.sector_benchmarks (caen_code, label, companies, dso_p25, dso_median, dso_p75, top_client_p25, top_client_median, top_client_p75, credit_notes_p25, credit_notes_median, credit_notes_p75, seasonality_p25, seasonality_median, seasonality_p75, gross_margin_p25, gross_margin_median, gross_margin_p75) values",
  SECTOR_BENCHMARKS.map(
    (s) =>
      `  (${q(s.caenCode)}, ${q(s.label)}, ${s.companies}, ${[...s.dsoDays, ...s.topClientSharePct, ...s.creditNotesPct, ...s.seasonalityRatio, ...s.grossMarginPct].join(", ")})`,
  ).join(",\n") +
    "\non conflict (caen_code) do update set label = excluded.label, companies = excluded.companies, dso_p25 = excluded.dso_p25, dso_median = excluded.dso_median, dso_p75 = excluded.dso_p75, top_client_p25 = excluded.top_client_p25, top_client_median = excluded.top_client_median, top_client_p75 = excluded.top_client_p75, credit_notes_p25 = excluded.credit_notes_p25, credit_notes_median = excluded.credit_notes_median, credit_notes_p75 = excluded.credit_notes_p75, seasonality_p25 = excluded.seasonality_p25, seasonality_median = excluded.seasonality_median, seasonality_p75 = excluded.seasonality_p75, gross_margin_p25 = excluded.gross_margin_p25, gross_margin_median = excluded.gross_margin_median, gross_margin_p75 = excluded.gross_margin_p75, updated_at = now();",
  "",
];

const invoices = generateSyntheticInvoices();
const cols =
  "(id, company_id, number, direction, invoice_type_code, issue_date, due_date, supplier_name, supplier_cui, customer_name, customer_cui, tax_exclusive_amount, payable_amount, currency, paid_date, source)";
for (let i = 0; i < invoices.length; i += 200) {
  const chunk = invoices.slice(i, i + 200);
  lines.push(`insert into public.e_invoices ${cols} values`);
  lines.push(
    chunk
      .map(
        (v) =>
          `  (${[v.id, c.id, v.number, v.direction, v.typeCode, v.issueDate, v.dueDate, v.supplierName, v.supplierCui, v.customerName, v.customerCui].map(q).join(", ")}, ${v.taxExclusiveAmount}, ${v.payableAmount}, ${q(v.currency)}, ${q(v.paidDate)}, 'synthetic')`,
      )
      .join(",\n") + ";",
  );
  lines.push("");
}
lines.push("commit;", "");

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), lines.join("\n"));
console.log(`supabase/seed.sql: 1 company, ${SECTOR_BENCHMARKS.length} benchmarks, ${invoices.length} invoices`);
